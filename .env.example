# PostgreSQL exclusivo do backend. Compose é opcional para desenvolvimento.
POSTGRES_PASSWORD=altere_esta_senha
DATABASE_URL=postgresql://revenda:altere_esta_senha@localhost:5432/revenda?schema=public
# Supabase Auth: somente a chave publicável, nunca service role.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Origem pública exata para login e validação de mutações. HTTPS em produção.
APP_URL=http://localhost:3000
# Fiscal exclusivamente em homologação; não habilita produção.
FOCUS_NFE_ENVIRONMENT=homologacao
FOCUS_NFE_TOKEN=
FISCAL_ENVIRONMENT=homologacao
# Polling opcional em processo Node persistente; não envia notas READY.
FISCAL_POLLING_ENABLED=false
# Agendador externo: POST /api/reminders/run com Bearer deste segredo.
# Cria avisos/jobs. Transporte push ainda não configurado.
REMINDER_SCHEDULER_SECRET=
# Reservadas para futura integração push. Não habilitam envio nesta versão.
NEXT_PUBLIC_WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=
WEB_PUSH_SUBJECT=
